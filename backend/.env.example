# AnkiBase settings. install.sh writes backend/.env for you; everything here is optional.

# The port AnkiBase listens on.
APP_PORT=8000

# Origins allowed to call the API from another address (only for a separately served
# frontend during development; the app itself doesn't need it).
CORS_ORIGINS=http://localhost:5173

# How the in-app updater finds new versions: "release" (tagged releases, the default)
# or "main" (every commit on the main branch).
UPDATE_CHANNEL=release

# Server-wide AI keys, used by every profile that hasn't saved its own in Settings → AI.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Secrets are generated on first start into backend/data/.secrets. Set these only to
# provide your own.
# APP_SECRET_KEY=
# ANKIWEB_ENCRYPTION_KEY=
