# Copy to local.env (ignored by git) to set up your own build. Everything is optional.

# The app's bundle identifier (SideStore/AltStore re-sign it with your Apple ID).
ANKIBASE_BUNDLE_ID=io.github.ankibase

# The AnkiBase server new installs connect to. Empty: the app starts on its own and you
# connect a server in Settings → Server (or never).
ANKIBASE_SERVER=

# A SideStore/AltStore source the app checks for new builds (Settings → Server → App).
ANKIBASE_UPDATE_FEED=

# scripts/publish.py: copies the .ipa to PUBLISH_DIR on PUBLISH_SSH_HOST (served at
# PUBLISH_BASE_URL) and lists it in the source there (source.json and ankibase-source.json).
PUBLISH_SSH_HOST=
PUBLISH_DIR=
PUBLISH_BASE_URL=
PUBLISH_DEVELOPER=
